      "name": "plan activity"
    },
    {
      "id": "j-EkTKr8LlWzz4O4mV4PV",
      "type": "text",
      "x": 6396.974428290456,
      "y": 1177.7042517775099,
      "width": 496.2109375,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6b",
      "roundness": null,
      "seed": 1342964230,
      "version": 1834,
      "versionNonce": 165052166,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791493048874,
      "created": 1791491331575,
      "link": null,
      "locked": false,
      "text": "Note on temporal.io activities:\nThey are fundamentally units of code that belong\nto an orchestation workflow, they may or may not\nuse AI agents within them.\n\nplan activity:\nuse an agent to read the codebase, understand\nthe requirement through diff.title, diff.description\nand diff.instruction columns; return a detailed\ninstruction for the implementation agent (inside\nimplementation activity)\n\nimplementation activity:\nuse the received instruction to perform write\noperations in the given codebase, iterate the\nprocess until the agent is satisifed with the\nchanges (or reached max-iterations limit), commit\nthe changes and return commit information\n\nreview activity:\nrun git diff, understand what the changes mean,\ncompare with the intention of the diff data\n(description, instruction), run tests, make sure all\nis sound and that the change is ready to\nproduction. return an optional refined plan for\nfurther iteration of the dev process.\n\nrelease activity:\nmerge feature branch into main, push changes to\nproduction, return head of the version control.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note on temporal.io activities:\nThey are fundamentally units of code that belong to an orchestation workflow, they may or may not use AI agents within them.\n\nplan activity:\nuse an agent to read the codebase, understand the requirement through diff.title, diff.description and diff.instruction columns; return a detailed instruction for the implementation agent (inside implementation activity)\n\nimplementation activity:\nuse the received instruction to perform write operations in the given codebase, iterate the process until the agent is satisifed with the changes (or reached max-iterations limit), commit the changes and return commit information\n\nreview activity:\nrun git diff, understand what the changes mean, compare with the intention of the diff data (description, instruction), run tests, make sure all is sound and that the change is ready to production. return an optional refined plan for further iteration of the dev process.\n\nrelease activity:\nmerge feature branch into main, push changes to production, return head of the version control.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
